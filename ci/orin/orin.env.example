# Copy to the Orin workspace as qplugin.env (plain KEY=value, without shell quotes).
# Existing process environment values take precedence.
QPLUGIN_REPOSITORY=https://github.com/glowingstone124/QPlugin-Survival2.git
QPLUGIN_DEFAULT_REVISION=hot-update
QPLUGIN_RELEASE_STORE=/opt/server/orin/releases/qplugin
QPLUGIN_DOWNLOADS=/opt/server/orin/downloads/qplugin
# Optional: a different existing Orin instance that builds the release.
# QPLUGIN_BUILD_NODE=build-node
